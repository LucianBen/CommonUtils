<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="home_surface">#FFFBFE</color>
    <color name="home_card">#F3EDF7</color>
    <color name="home_primary">#6750A4</color>
    <color name="home_container">#EADDFF</color>
    <color name="home_on_container">#21005D</color>
    <color name="home_text">#1D1B20</color>
    <color name="home_secondary_text">#625B71</color>
    <color name="home_notice">#FFF0D8</color>
    <color name="home_notice_text">#6D4713</color>
    <style name="Theme.CommonUtils.Home" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/home_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/home_container</item>
        <item name="colorOnPrimaryContainer">@color/home_on_container</item>
        <item name="colorSurface">@color/home_surface</item>
        <item name="colorOnSurface">@color/home_text</item>
        <item name="colorOnSurfaceVariant">@color/home_secondary_text</item>
        <item name="android:windowBackground">@color/home_surface</item>
        <item name="android:statusBarColor">@color/home_surface</item>
        <item name="android:navigationBarColor">@color/home_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>
</resources>
